#!/usr/bin/env bash
# MMT - MF4 Methylation Toolkit: methylation analyses on top of a MATAFILER4 + GeneCat run.
#   mmt <command> [options]      mmt help <command>
# Put it on your PATH with a symlink:  ln -s /path/to/MMT/mmt ~/bin/mmt
set -Eeuo pipefail
MMT_HOME=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
MMT_VERSION=$(< "$MMT_HOME/VERSION")
export MMT_HOME
# shellcheck source=lib/common.sh
source "$MMT_HOME/lib/common.sh"

main_help() {
    cat << EOF
MMT $MMT_VERSION - MF4 Methylation Toolkit
Methylation (PacBio HiFi kinetics: m6A, m4C) on top of a MATAFILER4 run and its GeneCat MGS stage.

Usage: mmt <command> [options]

Commands
  MGScall   methylation of each MGS per sample: --mgs-rep  the reads of every MAG of the MGS pooled, on the
              representative | --mag-rep  each MAG's reads apart, on the representative | --mag-mag  each MAG's
              reads on the MAG itself
  derep-ctg each MGS as a short list of collinear blocks ("dereplicated contigs") with every occurrence in
              every MAG down to the base, block sequences and block order along the contigs
              (also: dereplicate-contigs, derep)
  ctg-meth  methylation of every MAG's own contigs per sample, lifted onto the derep-ctg blocks, with read
              sets per junction (conformation) of a contig
  check     show the settings in effect, check tools and inputs (with -o: build / refresh the index)
  status    what is done per MGS in an output folder: per sample done / linked / not yet ... (also into the mmt log)
  version   print the version (and git commit)
  help      this text, or 'mmt help <command>'

Settings: config/mmt.conf (defaults) -> config/site.conf (your cluster) -> \$MMT_CONFIG -> --config FILE
          -> command-line options.
Results (-o): one folder per analysis (mgs-rep/, mag-rep/, mag-mag/, derep-ctg/, ctg-meth/), each with its tables and
          stats/ (per sample: what is done, the run's read counts, chemistry and kinetics model), and mmt_<date>.log =
          the log of every run (plan per MGS, each sample x MGS outcome, failures). Nothing else.
Run logs: only with -l DIR (DIR/<analysis>/<sample>.log). Work space (--tmp): work folders (removed when a sample
          ends; --debug keeps them) and caches (the MATAFILER4 / GeneCat index, reference indexes) - use a shared
          scratch folder on a cluster.
EOF
}

module_file() {   # module_file COMMAND -> modules/<file>.sh
    case $1 in
        MGScall|mgscall) echo "$MMT_HOME/modules/MGScall.sh" ;;
        derep-ctg|dereplicate-contigs|derep) echo "$MMT_HOME/modules/derep-ctg.sh" ;;
        ctg-meth|ctgmeth) echo "$MMT_HOME/modules/ctg-meth.sh" ;;
        check)           echo "$MMT_HOME/modules/check.sh" ;;
        status)          echo "$MMT_HOME/modules/status.sh" ;;
        *) return 1 ;;
    esac
}

MMT_CMD=${1:-help}
[[ $# -gt 0 ]] && shift
case $MMT_CMD in
    help|-h|--help)
        if [[ -n ${1:-} ]]; then
            f=$(module_file "$1") || usage_die "unknown command '$1'"
            # shellcheck source=/dev/null
            source "$f"; module_help
        else
            main_help
        fi ;;
    version|-v|--version)
        echo "MMT $(mmt_version)" ;;
    *)
        f=$(module_file "$MMT_CMD") || { echo "mmt: unknown command '$MMT_CMD' (see: mmt help)" >&2; exit 2; }
        MMT_CMD=$(basename "$f" .sh)
        # shellcheck source=/dev/null
        source "$f"
        load_config "$@"
        module_main "$@" ;;
esac
